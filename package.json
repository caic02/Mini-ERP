{
  "name": "middleby-rh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "prisma generate && tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "desktop": "tsx scripts/launch.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:file": "tsx scripts/test-file-storage.ts",
    "test:storage": "tsx --test tests/storage/*.test.ts",
    "test:browser": "playwright test",
    "format": "prettier --write server src tests scripts/*.ts *.ts *.json",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "admin": "tsx scripts/create-user.ts",
    "storage:check": "tsx scripts/check-file-storage.ts",
    "storage:export": "tsx scripts/export-file-storage.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.8.2",
    "bcryptjs": "3.0.2",
    "cookie-parser": "1.4.7",
    "dotenv": "16.5.0",
    "express": "5.1.0",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.2",
    "@types/node": "22.15.21",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "4.5.0",
    "concurrently": "9.1.2",
    "prettier": "3.9.10",
    "prisma": "6.8.2",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vite": "6.4.5"
  }
}
